#compdef nightcore

_nightcore() {
    local context state line
    typeset -A opt_args

    _arguments -C \
        '1:input audio file:_files -g "*.flac *.wav *.aiff *.aif *.ape *.wv *.tta *.alac *.m4a *.mp3 *.ogg *.oga *.opus *.aac *.wma *.mpc *.ac3 *.dts *.amr *.speex *.mp2 *.lrc (#i)"' \
        '-s+[Speed factor (e.g. 1.2 = 20% faster)]:speed:(1.1 1.15 1.2 1.25 1.3 0.9 0.85 0.8)' \
        '--speed+[Speed factor (e.g. 1.2 = 20% faster)]:speed:(1.1 1.15 1.2 1.25 1.3 0.9 0.85 0.8)' \
        '-r[Use reciprocal of speed (1.2 becomes 1\/1.2)]' \
        '--reciprocal[Use reciprocal of speed (1.2 becomes 1\/1.2)]' \
        '-R[Resample output to the next higher standard sample rate]' \
        '--resample[Resample output to the next higher standard sample rate]' \
        '-F+[Output format]:format:(flac alac mp3 opus aac)' \
        '--format+[Output format]:format:(flac alac mp3 opus aac)' \
        '--lossy-opts-[Extra lossy encoder flags (use --opt="...")]: : ' \
        '--batch+[Convert directory to .\/encodes\/format]:dir:_files -\/' \
        '--stats+[Print folder statistics]:dir:_files -/' \
        '--recurse+[Recurse subdirectories for --stats]:depth:(2 3)' \
        '-p[Pitch-shift only (duration preserved) instead of speeding up]' \
        '--pitch[Pitch-shift only (duration preserved) instead of speeding up]' \
        '-S+[Pitch-shift by semitones (implies pitch-only)]:semitones:(1.65 2.41 3.16 3.86 4.55)' \
        '--semitones+[Pitch-shift by semitones (implies pitch-only)]:semitones:(1.65 2.41 3.16 3.86 4.55)' \
        '--pitch-diff+[Pitch difference calculator]: :' \
        '--speed-diff+[Semitones to speed factor]: :' \
        '-D[Undo from filename tags: reads and removes Nx/Nst]' \
        '--denightcore[Undo from filename tags: reads and removes Nx/Nst]' \
        '-n[Print output filename(s) and exit without converting]' \
        '--dry-run[Print output filename(s) and exit without converting]' \
        '--autorename+[Rename output via filename template (bare = default template)]: : ' \
        '-N[Retag mode: rewrite tags and rename in place]' \
        '--renametag[Retag mode: rewrite tags and rename]' \
        '--in-place[With -N batch: renametag alongside inputs]' \
        '-o+[Override the output filename]: :' \
        '--output+[Override the output filename]: :' \
        '--output-folder+[Base directory for batch folders]:dir:_files -/' \
        '--no-delete-tags[With template: keep unlisted source tags]' \
        '--no-stamp[Skip the DESCRIPTION provenance stamp]' \
        '--no-pipeline[Skip the encoder_settings pipeline tag]' \
        '--tag-template+[Tag template file]:template:_files' \
        '--cover+[Cover artwork PNG/JPG]:image:_files -g "*.png *.jpg *.jpeg (#i)"' \
        '--version[Print version and exit]' \
        '--check[Check external tools and exit]' \
        '-y[Overwrite output file if it exists]' \
        '--overwrite[Overwrite output file if it exists]' \
        '-q[Suppress tool output and progress lines]' \
        '--quiet[Suppress tool output and progress lines]' \
        '-h[Show help]' \
        '--help[Show help]' \
        '*::arg:->args'

    case $state in
        args)
            _files
            ;;
    esac
}

_nightcore "$@"
