#compdef nightcore nightcore.py

_nightcore() {
    local context state line
    typeset -A opt_args

    _arguments -C \
        '1:input audio file:_files -g "*.flac *.wav *.aiff *.aif *.ape *.wv *.tta *.alac *.m4a *.mp3 *.ogg *.oga *.opus *.aac *.wma *.mpc *.ac3 *.dts *.amr *.speex *.mp2 (#i)"' \
        '-s+[Speed factor (e.g. 1.2 = 20% faster)]:speed:(1.1 1.15 1.2 1.25 1.3 0.9 0.85 0.8)' \
        '--speed+[Speed factor (e.g. 1.2 = 20% faster)]:speed:(1.1 1.15 1.2 1.25 1.3 0.9 0.85 0.8)' \
        '-r[Use reciprocal of speed (1.2 becomes 1\/1.2)]' \
        '--reciprocal[Use reciprocal of speed (1.2 becomes 1\/1.2)]' \
        '-R[Resample output to the next higher standard sample rate]' \
        '--resample[Resample output to the next higher standard sample rate]' \
        '--target-rate+[Explicit resample target in Hz]:rate:(44100 48000 88200 96000 176400 192000)' \
        '-B[With resampling, generate both the weird-rate and standard-rate files]' \
        '--both[With resampling, generate both the weird-rate and standard-rate files]' \
        '-F+[Lossless output format]:format:(flac alac wav)' \
        '--format+[Lossless output format]:format:(flac alac wav)' \
        '-p[Pitch-shift only (duration preserved) instead of speeding up]' \
        '--pitch[Pitch-shift only (duration preserved) instead of speeding up]' \
        '-S+[Shift amount in semitones]:semitones:(1.65 2.41 3.16 3.86 4.55)' \
        '--semitones+[Shift amount in semitones]:semitones:(1.65 2.41 3.16 3.86 4.55)' \
        '--pitch-diff+[Pitch difference between two frequencies]: :'
        '-y[Overwrite output file if it exists]' \
        '--overwrite[Overwrite output file if it exists]' \
        '-h[Show help]' \
        '--help[Show help]' \
        '*::arg:->args'

    case $state in
        args)
            _files
            ;;
    esac
}

_nightcore "$@"
