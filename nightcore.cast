[0.001,"o","\r\r\n--batch         -- Convert directory to ./encodes/format\u001b[27m\r\n--both          -- With resampling, generate both the non-standard-rate and standard-rate files\u001b[27m\r\n--denightcore   -- Undo from filename tags: reads and removes Nx/Nst\u001b[27m\r\n--dry-run       -- Print output filename(s) and exit without converting\u001b[27m\r\n--format        -- Output format\u001b[27m\r\n--help          -- Show help\u001b[27m\r\n--lossy-opts    -- Extra lossy encoder flags (use --opt=\"...\")\u001b[27m\r\n--overwrite     -- Overwrite output file if it exists\u001b[27m\r\n--pitch-diff    -- Pitch difference calculator\u001b[27m\r\n--pitch         -- Pitch-shift only (duration preserved) instead of speeding up\u001b[27m\r\n--quiet         -- Suppress tool output and progress lines\u001b[27m\r\n--rb-params     -- Extra rubberband flags (use --opt=\"...\")\u001b[27m\r\n--reciprocal    -- Use reciprocal of speed (1.2 becomes 1/1.2)\u001b[27m\r\n--resample      -- Resample output to the next higher standard sample rate\u001b[27m\r\n--semitones     -- Pitch-shift by semitones (implies pitch-only)\u001b[27m\r\n--simple-title  -- Clean Title tag, optional suffix\u001b[27m\r\n--speed-diff    -- Semitones to speed factor\u001b[27m\r\n\u001b[J--speed         -- Speed factor (e.g. 1.2 = 20% faster)\u001b[27m\u001b[J\u001b[18A\u001b[0m\u001b[27m\u001b[24m\u001b[0m\u001b[39m\u001b[49m\r\u001b[15C"]
