# versions.env — pin every vendored tool + nightcore itself.
# Sourced by build.sh. Bump a version here, re-run ./build.sh.
# Any VAR can also be overridden from the environment, e.g.:
#   NIGHTCORE_VERSION=v2026.10.09-1 ./build.sh --full
#   SOX_VER=14.4.3 ./build.sh --fetch-only

# nightcore app source: empty = latest tag from the Gitea instance,
# set to a tag (e.g. v2026.10.09-1) to pin. NIGHTCORE_SRC env (a local
# path) still takes precedence over both when set.
NIGHTCORE_VERSION="v2026.10.17-1"

# windows python embed (portable tree) + embed zip staged as the Wine
# build env (headless-safe: the Burn installer .exe needs a window even
# with /quiet). WINE_PY_VER defaults to PY_VER.
PY_VER="${PY_VER:-3.14.8}"
WINE_PY_VER="${WINE_PY_VER:-$PY_VER}"

# tool downloads. _URL vars are overridable (mirrors); the rest are
# version numbers the default URLs are built from.
FFMPEG_URL="${FFMPEG_URL:-https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip}"
SOX_VER="${SOX_VER:-14.4.2}"
RUBBERBAND_VER="${RUBBERBAND_VER:-3.3.0}"
LAME_VER="${LAME_VER:-3.100.1}"
OPUS_VER="${OPUS_VER:-0.2-49-g4b96717}"
LIBOPUS_VER="${LIBOPUS_VER:-1.6.1-11-g788cc89}"
OPUS_FALLBACK_ZIP="${OPUS_FALLBACK_ZIP:-opus-tools-0.1.10-win64.zip}"
FLAC_VER="${FLAC_VER:-1.4.3}"
VORBIS_VER="${VORBIS_VER:-1.2.0}"

# python packages installed under Wine (and mutagen wheel for embed).
# Empty = latest from PyPI; set to pin (e.g. MUTAGEN_VER=1.47.0).
MUTAGEN_VER="${MUTAGEN_VER:-}"
PYINSTALLER_VER="${PYINSTALLER_VER:-}"

# NSIS .debs used for the setup installer.
NSIS_VER="${NSIS_VER:-3.12-1}"

# UPX packs ffmpeg/ffprobe (setup payloads) and the bundle's binaries
# so every dist exe stays under the 100MB Cloudflare/Gitea cap.
# UPX-packed binaries can trip Windows Defender/SmartScreen heuristics;
# build with --no-upx if that's worse for your users than big files.
UPX_VER="${UPX_VER:-5.2.1}"
